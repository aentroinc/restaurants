{
  "title": "AENTRO SLO / Error Budget",
  "uid": "aentro-error-budget",
  "tags": ["aentro", "slo"],
  "timezone": "Asia/Tokyo",
  "schemaVersion": 38,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability (30d)",
      "targets": [{"expr": "1 - (sum(rate(http_server_requests_total{status_code=~\"5..\"}[30d])) / sum(rate(http_server_requests_total[30d])))"}],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error budget remaining (30d, target 99.9%)",
      "targets": [{"expr": "1 - ((sum(rate(http_server_requests_total{status_code=~\"5..\"}[30d])) / sum(rate(http_server_requests_total[30d]))) / 0.001)"}],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Burn rate (1h)",
      "targets": [{"expr": "(sum(rate(http_server_requests_total{status_code=~\"5..\"}[1h])) / sum(rate(http_server_requests_total[1h]))) / 0.001"}],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4}
    }
  ]
}
