{
  "title": "AENTRO Platform Overview",
  "uid": "aentro-platform-overview",
  "tags": ["aentro", "platform"],
  "timezone": "Asia/Tokyo",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API requests / min",
      "targets": [{"expr": "sum(rate(http_server_requests_total[1m]))"}],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API error rate (5min)",
      "targets": [{"expr": "sum(rate(http_server_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_server_requests_total[5m]))"}],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API p95 latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le))"}],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API latency by endpoint (p95)",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le, http_route))"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DB connection pool",
      "targets": [{"expr": "db_pool_active / db_pool_size"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
    }
  ]
}
