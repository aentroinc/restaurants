  "emergency": {
    "title": "Emergency manual",
    "subtitle": "Tap the matching scenario",
    "stepCount": "{n} steps",
    "footer": "Stay calm. Speak up. Work as a team.",
    "listBack": "← List",
    "scenarios": {
      "fire": {
        "title": "Fire",
        "call": "119 (Fire dept.)",
        "steps": [
          "Shout 'KAJI-DA!' (Fire!) loudly. Alert all staff.",
          "Guide customers to the emergency exit (see evacuation map).",
          "If safe, do initial firefighting (extinguisher; cover oil fires with cloth).",
          "Shut off the gas main valve and electrical breaker.",
          "Call 119. State address and store name.",
          "Gather at the outside meeting point. Headcount. Notify manager."
        ]
      },
      "earthquake": {
        "title": "Earthquake",
        "steps": [
          "Shout 'EARTHQUAKE! Get LOW!' loudly.",
          "Guide customers to take cover under tables.",
          "Kitchen staff turn off the fire and step away from stoves.",
          "When shaking stops, secure the exit (open the door).",
          "Check for gas leaks. If any, ventilate — no flames!",
          "Report to manager and assess damage."
        ]
      },
      "robbery": {
        "title": "Robbery",
        "call": "110 (Police)",
        "steps": [
          "Do NOT resist. Life is the top priority.",
          "Follow the robber's instructions and hand over money.",
          "Observe the robber's features (height, clothes, voice, weapon).",
          "After the robber leaves, lock the door immediately.",
          "Call 110. Preserve the scene (do not touch).",
          "Review CCTV. Notify manager and HQ."
        ]
      },
      "food_poisoning": {
        "title": "Suspected food poisoning",
        "steps": [
          "Ask the customer about symptoms (vomiting, diarrhea, fever). Record time and items consumed.",
          "If severe, call an ambulance (119).",
          "Preserve the suspected items and ingredients (DO NOT discard).",
          "Notify the manager and HQ quality team immediately.",
          "Prepare service records for the public health office.",
          "Treat the customer with care. Compensation discussions are HQ's call."
        ]
      },
      "injury": {
        "title": "Customer injury",
        "call": "119 (Ambulance)",
        "steps": [
          "Check consciousness and breathing. If serious, call 119.",
          "If bleeding, apply pressure with a clean cloth.",
          "For burns, cool with running water (10-20 min).",
          "Bring AED if needed (location on store map).",
          "Record incident details (time, place, cause).",
          "Notify manager and HQ. Take customer contact info."
        ]
      },
      "anaphylaxis": {
        "title": "Anaphylaxis",
        "call": "119 (Ambulance)",
        "steps": [
          "Call 119 immediately. Say 'This is anaphylaxis.'",
          "Lay the customer on their back, raise their legs (shock position).",
          "If they have an EpiPen, help them use it (inject outer thigh).",
          "Keep the airway clear. Monitor consciousness and breathing continuously.",
          "If vomiting, turn to the side.",
          "Stay until paramedics arrive. Record items eaten and ingredients."
        ]
      }
    }
  },

